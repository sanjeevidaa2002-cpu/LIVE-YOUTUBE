# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Port (default 3000)
PORT=3000

# Security & Authentication Secret
JWT_SECRET="streamloop-super-secure-jwt-secret-key-change-in-prod"

# Video Upload Directory
UPLOAD_DIR="./uploads"

# Maximum Upload Size in Megabytes (default: 500)
MAX_UPLOAD_SIZE_MB=500

# Default YouTube RTMP Server URL
DEFAULT_RTMP_URL="rtmp://a.rtmp.youtube.com/live2"

# FFmpeg and FFprobe Binaries Path (leave empty to use system PATH)
FFMPEG_PATH=""
FFPROBE_PATH=""

# Auto-recovery flag on server reboot (true/false)
AUTO_RECOVER_STREAM=true

# Supabase Authentication & Database Configuration
SUPABASE_URL="YOUR_SUPABASE_PROJECT_URL"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
VITE_SUPABASE_URL="YOUR_SUPABASE_PROJECT_URL"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"


